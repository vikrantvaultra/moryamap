# --- Postgres (Neon) ---
# POOLED (pgbouncer) connection string — used at runtime. REQUIRED in prod.
# Neon dashboard → Connection Details → "Pooled connection"
DATABASE_URL="postgres://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/moryamap?sslmode=require"
# DIRECT connection string — used ONLY for migrations (npm run db:migrate).
DATABASE_URL_UNPOOLED="postgres://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/moryamap?sslmode=require"

# --- Upstash Redis (rate limiting + cached snapshot) ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Admin basic auth (middleware) ---
ADMIN_USER="admin"
ADMIN_PASSWORD="change-me"

# --- Salt for hashing reporter IPs / user agents (any long random string) ---
IP_HASH_SALT="change-me-long-random"

# --- Public site origin (share links, og:image URLs) ---
# Falls back to Vercel's production domain when unset.
NEXT_PUBLIC_SITE_URL="https://moryamap.example"

# --- Seva gate (UPI offering popup) ---
# The popup only appears when all three of these are set.
# The Razorpay account MUST belong to the beneficiary below: the popup tells
# visitors their offering goes directly to them.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Shown in the popup, e.g. "Shree Siddhivinayak Sarvajanik Ganeshotsav Mandal"
SEVA_BENEFICIARY=""
# Optional but recommended: Razorpay Dashboard → Webhooks → /api/donate/webhook
# with events qr_code.credited + payment.captured.
RAZORPAY_WEBHOOK_SECRET=""

# --- Ashirwad (/ashirwad, ₹501) ---
# Secret, unguessable URL of the Bappa artwork (e.g. a Vercel Blob with a
# random suffix). Never commit the image: this repo is public. Until this is
# set, /ashirwad takes no money and nothing links to it. Uses the Razorpay
# keys above. See src/assets/ashirwad/README.md.
ASHIRWAD_IMAGE_URL=""
